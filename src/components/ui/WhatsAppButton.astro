---
import { whatsappUrl, type Lang } from '../../lib/site';
import { getTextos } from '../../lib/i18n';
/**
 * Botón recto. «principal» (amarillo) es la acción principal: uno por pantalla.
 * «sec» es contorno de 1 px. Sin href abre WhatsApp en otra pestaña.
 */
interface Props { lang: Lang; variant?: 'principal' | 'sec' | 'senal' | 'linea' | 'negro'; size?: 'sm' | 'lg'; short?: boolean; label?: string; href?: string; class?: string }
const { lang, variant = 'principal', short = false, label, href, class: cls = '' } = Astro.props;
const t = getTextos(lang);
const externo = !href;
const texto = label ?? (short ? t.acciones.whatsappCorto : t.acciones.whatsapp);
const abajo = !!href && href.includes('#');
const principal = variant === 'principal' || variant === 'senal';
---
<a href={href ?? whatsappUrl(lang)} target={externo ? '_blank' : undefined} rel={externo ? 'noopener' : undefined}
  class:list={['btn', !principal && 'btn-sec', cls]}>
  <span>{texto}</span>
  <svg viewBox="0 0 16 16" class="flecha size-4" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d={abajo ? 'M8 2.5v11M3.5 9l4.5 4.5L12.5 9' : externo ? 'M4.5 11.5l7-7M5.5 4.5h6v6' : 'M2.5 8h11M9 3.5L13.5 8 9 12.5'} />
  </svg>
</a>
