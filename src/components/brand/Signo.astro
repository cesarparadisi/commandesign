---
/**
 * Signo de commandesign, versión sólida (retícula 15 × 15).
 * Debajo de 48 px se usa siempre esta versión. Toma el color del texto (currentColor).
 */
interface Props { size?: number | string; class?: string; label?: string }
const { size = 24, class: cls = '', label } = Astro.props;
---
<svg viewBox="0 0 15 15" width={size} height={size} class={cls} fill="currentColor" fill-rule="nonzero"
